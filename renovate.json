{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>RagedUnicorn/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Strip the leading 'n' from FFmpeg release tags and skip the -dev branch-point tags (FFmpeg publishes tags, not GitHub releases)",
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "FFmpeg/FFmpeg"
      ],
      "extractVersion": "^n(?<version>\\d+\\.\\d+(?:\\.\\d+)?)$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the FFmpeg version in the command test in sync with the Dockerfile ARG",
      "managerFilePatterns": [
        "/^test/ffmpeg_command_test\\.yml$/"
      ],
      "matchStrings": [
        "ff(?:mpeg|probe) version (?<currentValue>[^']+)'"
      ],
      "depNameTemplate": "FFmpeg/FFmpeg",
      "datasourceTemplate": "github-tags"
    }
  ],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 2
}
